{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "product-watcher-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "vars": {
    "API_ENV": "local",
    "SERVICE_NAME": "api"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-watcher-db",
      "database_id": "local-product-watcher-db"
    }
  ],
  "routes": [],
  "observability": {
    "enabled": true
  }
}
